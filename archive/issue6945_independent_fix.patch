+  def test_apply_cache_removes_only_cached_prefix(self):
+    """Applying a cache keeps all contents after the cached prefix."""
+    llm_request = self.create_llm_request(contents_count=3)
+    original_contents = list(llm_request.contents)
+
+    applied = self.manager._apply_cache_to_request(
