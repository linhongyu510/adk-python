+
+  @pytest.mark.parametrize("cache_contents_count", [1, 2])
+  def test_apply_cache_skips_cache_when_prefix_covers_request(
+      self, cache_contents_count
+  ):
+    """A cache that covers the request leaves the request unchanged."""
+    llm_request = self.create_llm_request(contents_count=1)
+    original_contents = list(llm_request.contents)
+    original_system_instruction = llm_request.config.system_instruction
+    original_tools = llm_request.config.tools
+    original_tool_config = llm_request.config.tool_config
+
+    applied = self.manager._apply_cache_to_request(
+        llm_request,
+        cache_name="cachedContents/test",
+        cache_contents_count=cache_contents_count,
+    )
+
+    assert applied is False
+    assert llm_request.contents == original_contents
+    assert llm_request.config.cached_content is None
